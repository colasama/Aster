{
  "$defs": {
    "AntiAliasing": {
      "enum": ["off", "fxaa", "ssaa2x", "ssaa4x"],
      "type": "string"
    },
    "BinaryRationalTime": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "exponent": {
              "format": "int16",
              "maximum": 1023,
              "minimum": -1074,
              "type": "integer"
            },
            "kind": {
              "const": "binary_rational",
              "type": "string"
            },
            "negative": {
              "const": false,
              "type": "boolean"
            },
            "significand": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": ["kind", "negative", "significand", "exponent"],
          "type": "object"
        }
      ]
    },
    "BlobDescriptor": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "byte_offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "element_count": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "element_type": {
          "$ref": "#/$defs/ElementType"
        }
      },
      "required": ["byte_offset", "byte_length", "element_type", "element_count"],
      "type": "object"
    },
    "BufferResourceDescriptor": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "element_count": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "element_type": {
          "$ref": "#/$defs/ElementType"
        }
      },
      "required": ["element_type", "element_count", "byte_length"],
      "type": "object"
    },
    "CameraIrisShape": {
      "enum": [
        "fastRectangle",
        "square",
        "triangle",
        "pentagon",
        "hexagon",
        "heptagon",
        "octagon",
        "nonagon",
        "decagon",
        "circle"
      ],
      "type": "string"
    },
    "CameraPoseMode": {
      "enum": ["oneNode", "twoNode"],
      "type": "string"
    },
    "CameraProjectionKind": {
      "enum": ["perspective", "orthographic"],
      "type": "string"
    },
    "ColorPipeline": {
      "enum": ["linear-hdr-to-srgb-display"],
      "type": "string"
    },
    "CompositionIdentity": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "$ref": "#/$defs/Utf16CompositionIdentity"
        }
      ]
    },
    "ContractLevel": {
      "enum": ["post_uniforms_slice_v1", "scene_buffers_slice_v1", "camera_parameters_slice_v1"],
      "type": "string"
    },
    "ElementType": {
      "enum": ["u8", "u32_le", "f32_le"],
      "type": "string"
    },
    "Extent2d": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": ["width", "height"],
      "type": "object"
    },
    "FrameHeaderSlice": {
      "additionalProperties": false,
      "properties": {
        "aa": {
          "$ref": "#/$defs/AntiAliasing"
        },
        "color_pipeline": {
          "$ref": "#/$defs/ColorPipeline"
        },
        "composition_id": {
          "$ref": "#/$defs/CompositionIdentity"
        },
        "frame_rate": {
          "$ref": "#/$defs/FrameRate"
        },
        "project_revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "render_target": {
          "$ref": "#/$defs/Extent2d"
        },
        "snapshot_scope": {
          "description": "Snapshot identity: 1..256 UTF-8 bytes, without NUL.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Extent2d"
        },
        "time": {
          "$ref": "#/$defs/FrameTime"
        }
      },
      "required": [
        "snapshot_scope",
        "project_revision",
        "composition_id",
        "time",
        "frame_rate",
        "target",
        "render_target",
        "aa",
        "color_pipeline"
      ],
      "type": "object"
    },
    "FrameRate": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            },
            "kind": {
              "const": "rational",
              "type": "string"
            },
            "numerator": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": ["kind", "numerator", "denominator"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "$ref": "#/$defs/BinaryRationalTime"
            },
            "kind": {
              "const": "binary_ratio",
              "type": "string"
            },
            "numerator": {
              "$ref": "#/$defs/BinaryRationalTime"
            }
          },
          "required": ["kind", "numerator", "denominator"],
          "type": "object"
        }
      ]
    },
    "FrameTime": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rational",
              "type": "string"
            },
            "scale": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            },
            "value": {
              "format": "int64",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": ["kind", "value", "scale"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exponent": {
              "format": "int16",
              "maximum": 1023,
              "minimum": -1074,
              "type": "integer"
            },
            "kind": {
              "const": "binary_rational",
              "type": "string"
            },
            "negative": {
              "type": "boolean"
            },
            "significand": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": ["kind", "negative", "significand", "exponent"],
          "type": "object"
        }
      ]
    },
    "MediaDrawBinding": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "hash": {
              "$ref": "#/$defs/ResourceHash"
            },
            "kind": {
              "const": "frame",
              "type": "string"
            }
          },
          "required": ["kind", "hash"],
          "type": "object"
        }
      ]
    },
    "MediaFrameDescriptor": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/MediaTextureFormat"
        },
        "height": {
          "format": "uint32",
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        },
        "sample": {
          "$ref": "#/$defs/MediaSample"
        },
        "source": {
          "$ref": "#/$defs/ResourceHash"
        },
        "width": {
          "format": "uint32",
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": ["source", "sample", "width", "height", "format"],
      "type": "object"
    },
    "MediaKind": {
      "enum": ["image", "sequence", "video"],
      "type": "string"
    },
    "MediaSample": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "image",
              "type": "string"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "file_identity": {
              "minLength": 1,
              "type": "string"
            },
            "frame": {
              "format": "int64",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "kind": {
              "const": "sequence",
              "type": "string"
            }
          },
          "required": ["kind", "frame", "file_identity"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "video",
              "type": "string"
            },
            "requested_time": {
              "$ref": "#/$defs/FrameTime"
            },
            "uploaded_time": {
              "$ref": "#/$defs/FrameTime"
            }
          },
          "required": ["kind", "requested_time", "uploaded_time"],
          "type": "object"
        }
      ]
    },
    "MediaSourceDescriptor": {
      "additionalProperties": false,
      "description": "The job broker resolves this identity; a descriptor never grants filesystem access.",
      "properties": {
        "authorization_scope": {
          "minLength": 1,
          "type": "string"
        },
        "content_identity": {
          "minLength": 1,
          "type": "string"
        },
        "media_kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "source_id": {
          "$ref": "#/$defs/CompositionIdentity"
        }
      },
      "required": ["source_id", "content_identity", "authorization_scope", "media_kind"],
      "type": "object"
    },
    "MediaTextureFormat": {
      "enum": ["rgba8unorm-srgb"],
      "type": "string"
    },
    "PlanKind": {
      "enum": ["frame_plan_slice"],
      "type": "string"
    },
    "PlanSlice": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "blob_index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "post_process_uniforms",
              "type": "string"
            }
          },
          "required": ["kind", "blob_index"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "blob_index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "draws": {
              "items": {
                "$ref": "#/$defs/SceneDrawRecord"
              },
              "type": "array"
            },
            "kind": {
              "const": "scene_buffers",
              "type": "string"
            },
            "media_bindings": {
              "items": {
                "$ref": "#/$defs/SceneMediaBinding"
              },
              "type": "array"
            },
            "motion_vectors": {
              "type": "boolean"
            },
            "shadows_enabled": {
              "type": "boolean"
            },
            "vertex_count": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "blob_index",
            "vertex_count",
            "motion_vectors",
            "shadows_enabled",
            "draws",
            "media_bindings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "blob_index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "depth_of_field": {
              "type": "boolean"
            },
            "iris_shape": {
              "$ref": "#/$defs/CameraIrisShape"
            },
            "kind": {
              "const": "camera_parameters",
              "type": "string"
            },
            "lock_focus_to_zoom": {
              "type": "boolean"
            },
            "optics_projection": {
              "$ref": "#/$defs/CameraProjectionKind"
            },
            "pose_mode": {
              "$ref": "#/$defs/CameraPoseMode"
            },
            "projection_kind": {
              "$ref": "#/$defs/CameraProjectionKind"
            }
          },
          "required": [
            "kind",
            "blob_index",
            "pose_mode",
            "projection_kind",
            "optics_projection",
            "depth_of_field",
            "lock_focus_to_zoom",
            "iris_shape"
          ],
          "type": "object"
        }
      ]
    },
    "PutResource": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/ResourceDescriptor"
        },
        "hash": {
          "$ref": "#/$defs/ResourceHash"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": ["hash", "kind", "descriptor"],
      "type": "object"
    },
    "ResourceDescriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/BufferResourceDescriptor"
        },
        {
          "$ref": "#/$defs/MediaSourceDescriptor"
        },
        {
          "$ref": "#/$defs/MediaFrameDescriptor"
        }
      ]
    },
    "ResourceHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ResourceKind": {
      "enum": ["buffer", "media_source", "media_frame"],
      "type": "string"
    },
    "ResourceMessage": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "descriptor": {
              "$ref": "#/$defs/ResourceDescriptor"
            },
            "hash": {
              "$ref": "#/$defs/ResourceHash"
            },
            "kind": {
              "$ref": "#/$defs/ResourceKind"
            },
            "type": {
              "const": "put_resource",
              "type": "string"
            }
          },
          "required": ["type", "hash", "kind", "descriptor"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "hash": {
              "$ref": "#/$defs/ResourceHash"
            },
            "type": {
              "const": "evict_resource",
              "type": "string"
            }
          },
          "required": ["type", "hash"],
          "type": "object"
        }
      ]
    },
    "SceneDrawRecord": {
      "additionalProperties": false,
      "properties": {
        "casts_shadow": {
          "type": "boolean"
        },
        "first_vertex": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "instance_id": {
          "$ref": "#/$defs/CompositionIdentity"
        },
        "resource_instance_id": {
          "$ref": "#/$defs/CompositionIdentity"
        },
        "selection_id": {
          "$ref": "#/$defs/CompositionIdentity"
        },
        "vertex_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "instance_id",
        "resource_instance_id",
        "selection_id",
        "first_vertex",
        "vertex_count",
        "casts_shadow"
      ],
      "type": "object"
    },
    "SceneMediaBinding": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/MediaDrawBinding"
        },
        "draw_index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["draw_index", "binding"],
      "type": "object"
    },
    "Utf16CompositionIdentity": {
      "additionalProperties": false,
      "properties": {
        "utf16_units": {
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["utf16_units"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blobs": {
      "items": {
        "$ref": "#/$defs/BlobDescriptor"
      },
      "minItems": 1,
      "type": "array"
    },
    "contract_level": {
      "$ref": "#/$defs/ContractLevel"
    },
    "header": {
      "$ref": "#/$defs/FrameHeaderSlice"
    },
    "kind": {
      "$ref": "#/$defs/PlanKind"
    },
    "plan_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "renderer_plan_complete": {
      "const": false,
      "type": "boolean"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceHash"
      },
      "type": "array"
    },
    "slices": {
      "items": {
        "$ref": "#/$defs/PlanSlice"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "kind",
    "plan_version",
    "contract_level",
    "renderer_plan_complete",
    "header",
    "blobs",
    "slices",
    "resources"
  ],
  "title": "FramePlanSliceV1",
  "type": "object"
}

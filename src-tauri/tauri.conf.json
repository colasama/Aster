{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aster",
  "version": "0.2.0",
  "identifier": "com.colanns.asterstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aster — Untitled Project",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximized": false,
        "decorations": true,
        "backgroundColor": "#111216"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

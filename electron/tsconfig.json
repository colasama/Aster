{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node", "electron"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "../dist-electron"
  },
  "include": [
    "*.ts",
    "*.cts",
    "../src/ai/agent-protocol.ts",
    "../src/core/render-queue.ts",
    "../src/desktop/preferences.ts"
  ],
  "exclude": ["*.test.ts"]
}
